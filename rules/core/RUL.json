{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RUL",
    "title": "Rule",
    "description": "A single-phrase behavioral constraint or property definition attached to an entity."
  },
  "rule_set": {
    "version": "0.17.0",
    "timestamp": "2026-10-22T10:01:49Z",
    "hash": "blake3:244551bc0b6c0a419a73e9fc90a0ab24f8fc65fa8c7753220b8db3780bc7d3aa"
  },
  "rules": [
    {
      "id": "RUL-001",
      "revision": 0,
      "state": "I",
      "body": "DEFINES a single property of an entity or describes the behavior of that property.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "RUL-002",
      "revision": 0,
      "state": "I",
      "body": "IS uniquely identified using a Rule Format.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "RUL-003",
      "revision": 0,
      "state": "I",
      "body": "Rule identifiers MUST NOT be reused, even if the rule is deprecated or deleted.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "RUL-004",
      "revision": 0,
      "state": "P",
      "body": "MUST be expressed as a single phrase.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "RUL-005",
      "revision": 0,
      "state": "I",
      "body": "MAY be supplemented by one or more notes to provide context or clarification.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "RUL-006",
      "revision": 0,
      "state": "I",
      "body": "HAS a Rule State.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "RUL-007",
      "revision": 0,
      "state": "I",
      "body": "Once a Rule IS in State other than Draft then it is immutable.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "RUL-008",
      "revision": 0,
      "state": "I",
      "body": "Once a Rule IS immutable, modifications must be introduced by superseding it with a new rule.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    }
  ],
  "sub_entities": [
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "RULST",
        "title": "Rule State",
        "description": "The lifecycle state of a rule, governing its mutability and enforcement.",
        "parent": "RUL"
      },
      "rule_set": {
        "version": "0.18.0",
        "timestamp": "2026-10-22T10:01:49Z",
        "hash": "blake3:5526a6f636cb4b97f723ac652cdf486c5ecb5c31f8d4bc1a3a619449722626ac"
      },
      "rules": [
        {
          "id": "RULST-001",
          "revision": 1,
          "state": "I",
          "body": "A Rule MAY have a state: Draft (D), Abandoned (A), Published (P), Implemented (I), Retired (R), Terminated (T).",
          "added_by": "@pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "RULST-002",
          "revision": 0,
          "state": "I",
          "body": "Each State can only be applied once to a Rule.",
          "added_by": "@pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "RULST-003",
          "revision": 0,
          "state": "I",
          "body": "Draft IS the initial state.",
          "added_by": "@pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "RULST-004",
          "revision": 0,
          "state": "I",
          "body": "Abandoned IS a terminal state which applies to Rules which were previously in Draft.",
          "added_by": "@pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "RULST-005",
          "revision": 0,
          "state": "I",
          "body": "Published applies to Rule which have been validated but aren't yet implemented.",
          "added_by": "@pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "RULST-006",
          "revision": 0,
          "state": "I",
          "body": "Implemented applies to Rule which are in force.",
          "added_by": "@pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "RULST-007",
          "revision": 1,
          "state": "I",
          "body": "Retired applies to Rule which are still in force or present but must be removed.",
          "added_by": "@pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "RULST-008",
          "revision": 0,
          "state": "I",
          "body": "Terminated applies to Rule which aren't in force anymore.",
          "added_by": "@pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "RULST-009",
          "revision": 0,
          "state": "D",
          "body": "A Rule MUST NOT enter Implemented while the governed code is known to violate it.",
          "added_by": "@pleberre",
          "added_at": "2026-10-22",
          "supersedes": null
        }
      ],
      "notes": [
        {
          "id": "RULST-009/01",
          "rule_ref": "RULST-009",
          "type": "rationale",
          "content": "Published is the standard's position and may sit on violating code; Implemented means the rule is in force and the code complies with it.",
          "added_by": "@pleberre",
          "added_at": "2026-10-22",
          "revision": 0
        },
        {
          "id": "RULST-009/02",
          "rule_ref": "RULST-009",
          "type": "clarification",
          "content": "Promote Draft to Published as soon as the wording is final, and Published to Implemented only once compliance and enforcement exist.",
          "added_by": "@pleberre",
          "added_at": "2026-10-22",
          "revision": 0
        }
      ]
    }
  ],
  "notes": []
}
