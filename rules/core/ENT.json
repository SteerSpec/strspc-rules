{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "ENT",
    "title": "Entity",
    "description": "An object with a unique identity and lifecycle. The unit of organization in the SteerSpec rule system."
  },
  "rule_set": {
    "version": "0.7.0",
    "timestamp": "2026-10-18T11:20:06Z",
    "hash": "blake3:3983fc0822c608990fe4348958483106ebf37b95f103299b74e4bbb608658776"
  },
  "rules": [
    {
      "id": "ENT-001",
      "revision": 0,
      "state": "P",
      "body": "IS an object that has a unique identity that persists over time.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "ENT-002",
      "revision": 0,
      "state": "P",
      "body": "MAY transition through multiple states during its lifecycle.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "ENT-003",
      "revision": 0,
      "state": "P",
      "body": "MAY possess one or more properties.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "ENT-004",
      "revision": 0,
      "state": "P",
      "body": "The behavior of an entity IS defined entirely by the Rules applicable to its identity, properties, and states.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "ENT-005",
      "revision": 0,
      "state": "P",
      "body": "HAS an Entity Unique Identifier.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    }
  ],
  "sub_entities": [
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "ENTUQID",
        "title": "Entity Unique Identifier",
        "description": "The unique identifier assigned to each entity within a Realm.",
        "parent": "ENT"
      },
      "rule_set": {
        "version": "0.4.0",
        "timestamp": "2026-10-18T11:20:06Z",
        "hash": null
      },
      "rules": [
        {
          "id": "ENTUQID-001",
          "revision": 0,
          "state": "P",
          "body": "MUST have a length of at least 3 and at most 18 characters.",
