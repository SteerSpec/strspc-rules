{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "ENT",
    "title": "Entity",
    "description": "An object with a unique identity and lifecycle. The unit of organization in the SteerSpec rule system."
  },
  "rule_set": {
    "version": "0.12.3",
    "timestamp": "2026-10-18T16:34:31Z",
    "hash": "blake3:bced7a49a5ddc7b2e8f6ed6455af3d43bf118286108ded5f15bc838ec64e1787"
  },
  "rules": [
    {
      "id": "ENT-001",
      "revision": 0,
      "state": "I",
      "body": "IS an object that has a unique identity that persists over time.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "ENT-002",
      "revision": 0,
      "state": "I",
      "body": "MAY transition through multiple states during its lifecycle.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "ENT-003",
      "revision": 0,
      "state": "I",
      "body": "MAY possess one or more properties.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "ENT-004",
      "revision": 0,
      "state": "I",
      "body": "The behavior of an entity IS defined entirely by the Rules applicable to its identity, properties, and states.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "ENT-005",
      "revision": 0,
      "state": "I",
      "body": "HAS an Entity Unique Identifier.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    }
  ],
  "sub_entities": [
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "ENTUQID",
        "title": "Entity Unique Identifier",
        "description": "The unique identifier assigned to each entity within a Realm.",
        "parent": "ENT"
      },
      "rule_set": {
        "version": "0.7.0",
        "timestamp": "2026-10-18T16:34:31Z",
        "hash": "blake3:5d965a89cd7df645c871491a4f8a2705f84fd76d0285f9d49e42dba7651f734a"
      },
      "rules": [
        {
          "id": "ENTUQID-001",
          "revision": 0,
          "state": "I",
          "body": "MUST have a length of at least 3 and at most 18 characters.",
          "added_by": "@pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "ENTUQID-002",
          "revision": 0,
          "state": "I",
          "body": "IS a string of letters or numbers only.",
          "added_by": "@pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "ENTUQID-003",
          "revision": 0,
          "state": "I",
          "body": "IS unique within the Realm.",
          "added_by": "@pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        }
      ],
      "notes": []
    }
  ],
  "notes": []
}
